extend type Query {

    get_user(id: Int!): User!
    me: User! @isAuth

}

extend type Mutation {
     login(email: String!, password: String!): User!
     logout:Boolean!
     register(email: String!, password: String!, name: String!): User!
}

type User @goModel(model: "github.com/Higins/blocks/model.User") {
    id: Int
    name: String
    email: String
}


